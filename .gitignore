# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# LaTeX build artifacts (keep the .tex and the final .pdf under reports/pdf)
reports/tex/*.aux
reports/tex/*.log
reports/tex/*.out
reports/tex/*.toc
reports/tex/*.fls
reports/tex/*.fdb_latexmk
reports/tex/*.synctex.gz

# Large scratch — checkpoints ARE committed (they are the reconstruction cache);
# only ignore genuinely transient scratch here.
*.tmp
scratch/

# OS
.DS_Store
reports/tex/*.pdf
reports/tex/*.aux
reports/tex/*.log
reports/tex/*.out

# Sector graph renderings (R9 sec.7): 112 MB of .dot + .png for 22 rules x 3
# diagrams.  Deterministic and regenerable in ~10 min with
#   python -m qca_fragmentation.viz.dot_sectors --N 11 --bc obc0
# so the generator and the summary table are tracked and the blobs are not.
figures/sector_graphs/*.dot
figures/sector_graphs/*.png
